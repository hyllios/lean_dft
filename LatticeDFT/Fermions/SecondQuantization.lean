import LatticeDFT.Fermions.Slater
import LatticeDFT.HK.Basic

/-!
# Second quantisation via determinants

* `amp s τ`: antisymmetrised overlap of a position tuple with a configuration; `slater_expand`
  (special Cauchy–Binet).
* `Γ h`: many-body matrix of a single-particle operator; fermionic signs generated by determinants.
* `gamma_slater`: Slater determinants of eigen-orbitals are many-body eigenvectors.
* `gamma_add`, `gamma_smul`, `gamma_diagonal`, `gamma_isSymm`.
* `H0F G t Vint`: spinless fermions with hopping `t` on the edges of `G` and a
  configuration-diagonal interaction; `hamN_H0F` identifies the DFT Hamiltonian with
  `Γ(−tA + diag v) + diag Vint`.
-/

namespace LatticeDFT

section

open Matrix

variable {M N : ℕ}

/-- Sorted position tuple of a configuration. -/
def τs (s : Conf M N) : Fin N → Fin M := fun k => s.1.orderEmbOfFin s.2 k

lemma τs_mem (s : Conf M N) (k : Fin N) : τs s k ∈ s.1 := Finset.orderEmbOfFin_mem _ _ _

lemma τs_injective (s : Conf M N) : Function.Injective (τs s) :=
  (s.1.orderEmbOfFin s.2).injective

lemma τs_surj (s : Conf M N) {x : Fin M} (hx : x ∈ s.1) : ∃ k, τs s k = x := by
  have : x ∈ Set.range (s.1.orderEmbOfFin s.2) := by rw [Finset.range_orderEmbOfFin]; exact hx
  obtain ⟨k, hk⟩ := this; exact ⟨k, hk⟩

/-- Slater amplitude on a configuration. -/
def slaterC (φ : Fin N → Fin M → ℝ) (s : Conf M N) : ℝ := slater φ (τs s)

/-- Antisymmetrised overlap `⟨s|τ⟩`. -/
def amp (s : Conf M N) (τ : Fin N → Fin M) : ℝ :=
  slater (fun j x => if x = τs s j then 1 else 0) τ

lemma slater_of_not_injective (φ : Fin N → Fin M → ℝ) {τ : Fin N → Fin M}
    (h : ¬ Function.Injective τ) : slater φ τ = 0 := by
  simp only [Function.Injective, not_forall] at h
  obtain ⟨a, b, hab, hne⟩ := h
  exact det_zero_of_row_eq hne (by funext j; simp [hab])

lemma slater_perm (φ : Fin N → Fin M → ℝ) (τ : Fin N → Fin M) (σ : Equiv.Perm (Fin N)) :
    slater φ (fun k => τ (σ k)) = (Equiv.Perm.sign σ : ℝ) * slater φ τ := by
  unfold slater
  have : (Matrix.of fun k j => φ j (τ (σ k))) =
      (Matrix.of fun k j => φ j (τ k)).submatrix σ id := by
    ext k j; simp
  rw [this, det_permute]

lemma exists_perm_of_injective (s : Conf M N) {τ : Fin N → Fin M} (hinj : Function.Injective τ)
    (hmem : ∀ k, τ k ∈ s.1) : ∃ σ : Equiv.Perm (Fin N), ∀ k, τ k = τs s (σ k) := by
  choose f hf using fun k => τs_surj s (hmem k)
  have finj : Function.Injective f := by
    intro a b hab; apply hinj; rw [← hf a, ← hf b, hab]
  refine ⟨Equiv.ofBijective f (Finite.injective_iff_bijective.mp finj), fun k => ?_⟩
  simp [hf]

lemma amp_self (s : Conf M N) : amp s (τs s) = 1 := by
  unfold amp slater
  have : (Matrix.of fun k j => if τs s k = τs s j then (1 : ℝ) else 0) = 1 := by
    ext k j
    simp only [Matrix.of_apply, Matrix.one_apply]
    by_cases h : k = j
    · simp [h]
    · simp [h, (τs_injective s).ne h]
  rw [this, det_one]

lemma amp_of_not_mem (s : Conf M N) {τ : Fin N → Fin M} {k : Fin N} (hk : τ k ∉ s.1) : amp s τ =
    0 := by
  unfold amp slater
  apply det_eq_zero_of_row_eq_zero k
  intro j
  have : τ k ≠ τs s j := fun h => hk (h ▸ τs_mem s j)
  simp [this]

/-- Special Cauchy–Binet: `Ψ(τ) = Σ_s ⟨s|τ⟩ Ψ(s)`. -/
theorem slater_expand (φ : Fin N → Fin M → ℝ) (τ : Fin N → Fin M) :
    slater φ τ = ∑ s : Conf M N, amp s τ * slaterC φ s := by
  by_cases hinj : Function.Injective τ
  · set S := Finset.univ.image τ
    have hS : S.card = N := by rw [Finset.card_image_of_injective _ hinj]; simp
    set s0 : Conf M N := ⟨S, hS⟩
    have hmem : ∀ k, τ k ∈ s0.1 := fun k => Finset.mem_image_of_mem τ (Finset.mem_univ k)
    obtain ⟨σ, hσ⟩ := exists_perm_of_injective s0 hinj hmem
    have hτ : τ = fun k => τs s0 (σ k) := funext hσ
    rw [Finset.sum_eq_single s0]
    · rw [amp, hτ, slater_perm, slater_perm]
      have := amp_self s0
      unfold amp at this
      rw [this, slaterC]; ring
    · intro s _ hs
      have : ∃ k, τ k ∉ s.1 := by
        by_contra hall
        push Not at hall
        apply hs
        apply Subtype.ext
        symm
        apply Finset.eq_of_subset_of_card_le
        · intro x hx
          obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp hx
          exact hall k
        · rw [s.2, hS]
      obtain ⟨k, hk⟩ := this
      rw [amp_of_not_mem s hk, zero_mul]
    · intro h; exact absurd (Finset.mem_univ s0) h
  · rw [slater_of_not_injective φ hinj]
    symm
    apply Finset.sum_eq_zero
    intro s _
    rw [amp, slater_of_not_injective _ hinj, zero_mul]

/-- Second quantisation of a single-particle matrix. -/
def Γ (h : Matrix (Fin M) (Fin M) ℝ) : Matrix (Conf M N) (Conf M N) ℝ :=
  fun s s' => ∑ k, ∑ b, h (τs s k) b * amp s' (Function.update (τs s) k b)

/-- **Slater determinants are many-body eigenvectors.** -/
theorem gamma_slater (h : Matrix (Fin M) (Fin M) ℝ) (φ : Fin N → Fin M → ℝ) (ε : Fin N → ℝ)
    (hφ : ∀ j, h *ᵥ φ j = ε j • φ j) :
    (Γ h : Matrix (Conf M N) (Conf M N) ℝ) *ᵥ slaterC φ = (∑ j, ε j) • slaterC φ := by
  funext s
  simp only [Matrix.mulVec, dotProduct, Γ, Pi.smul_apply, smul_eq_mul]
  rw [slaterC, ← slater_eigen h φ ε hφ (τs s)]
  simp_rw [Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl; intro k _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl; intro b _
  rw [slater_expand φ (Function.update (τs s) k b), Finset.mul_sum]
  apply Finset.sum_congr rfl; intro s' _
  ring

end

section

open Matrix

variable {M N : ℕ}

lemma gamma_add (h₁ h₂ : Matrix (Fin M) (Fin M) ℝ) :
    (Γ (h₁ + h₂) : Matrix (Conf M N) (Conf M N) ℝ) = Γ h₁ + Γ h₂ := by
  ext s s'; simp [Γ, add_mul, Finset.sum_add_distrib]

lemma gamma_smul (c : ℝ) (h : Matrix (Fin M) (Fin M) ℝ) :
    (Γ (c • h) : Matrix (Conf M N) (Conf M N) ℝ) = c • Γ h := by
  ext s s'; simp [Γ, Finset.mul_sum, mul_assoc]

lemma amp_tau_eq (s s' : Conf M N) : amp s' (τs s) = if s = s' then 1 else 0 := by
  split_ifs with h
  · subst h; exact amp_self s
  · have : ∃ k, τs s k ∉ s'.1 := by
      by_contra hall
      push Not at hall
      apply h
      apply Subtype.ext
      apply Finset.eq_of_subset_of_card_le
      · intro x hx
        obtain ⟨k, rfl⟩ := τs_surj s hx
        exact hall k
      · rw [s.2, s'.2]
    obtain ⟨k, hk⟩ := this
    exact amp_of_not_mem s' hk

lemma sum_tau (s : Conf M N) (v : Fin M → ℝ) : ∑ k, v (τs s k) = ∑ i, v i * occF i s := by
  have h1 : ∑ i, v i * occF i s = ∑ i ∈ s.1, v i := by
    simp [occF, Finset.sum_ite_mem]
  rw [h1]
  have h2 : Finset.univ.image (τs s) = s.1 := by
    ext x; constructor
    · intro hx; obtain ⟨k, -, rfl⟩ := Finset.mem_image.mp hx; exact τs_mem s k
    · intro hx; obtain ⟨k, rfl⟩ := τs_surj s hx; exact Finset.mem_image_of_mem _ (Finset.mem_univ k)
  rw [← h2, Finset.sum_image (fun a _ b _ hab => τs_injective s hab)]

lemma gamma_diagonal (v : Fin M → ℝ) :
    (Γ (Matrix.diagonal v) : Matrix (Conf M N) (Conf M N) ℝ) =
      Matrix.diagonal (fun s => ∑ i, v i * occF i s) := by
  ext s s'
  simp only [Γ, Matrix.diagonal_apply]
  have : ∀ k, ∑ b, (if τs s k = b then v (τs s k) else 0) * amp s' (Function.update (τs s) k b) =
      v (τs s k) * amp s' (τs s) := by
    intro k
    rw [Finset.sum_eq_single (τs s k)]
    · simp
    · intro b _ hb; simp [Ne.symm hb]
    · intro h; exact absurd (Finset.mem_univ _) h
  simp_rw [this, amp_tau_eq, ← Finset.sum_mul, sum_tau]
  split_ifs <;> simp

/-- Product with one slot replaced: split off the replaced factor. -/
lemma prod_update_split (φ : Fin N → Fin M → ℝ) (τ : Fin N → Fin M) (σ : Equiv.Perm (Fin N))
    (i : Fin N) (b : Fin M) :
    ∏ j, φ j (Function.update τ i b (σ j)) =
      φ (σ.symm i) b * ∏ j, (if j = σ.symm i then 1 else φ j (τ (σ j))) := by
  set j0 := σ.symm i
  have hR : ∏ j, (if j = j0 then 1 else φ j (τ (σ j))) = ∏ j ∈ Finset.univ.erase j0,
      φ j (τ (σ j)) := by
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j0), ite_eq_left rfl, one_mul]
    apply Finset.prod_congr rfl; intro j hj; simp [(Finset.mem_erase.mp hj).1]
  rw [hR, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j0)]
  congr 1
  · simp [j0]
  · apply Finset.prod_congr rfl
    intro j hj
    have hj0 : j ≠ j0 := (Finset.mem_erase.mp hj).1
    have hne : σ j ≠ i := by intro h'; apply hj0; simp [j0, ← h']
    simp [Function.update_of_ne hne]

/-- Leibniz form of the second-quantised matrix element. -/
lemma gamma_leibniz (h : Matrix (Fin M) (Fin M) ℝ) (s s' : Conf M N) :
    (Γ h : Matrix (Conf M N) (Conf M N) ℝ) s s' =
      ∑ σ : Equiv.Perm (Fin N), (Equiv.Perm.sign σ : ℝ) * ∑ j0, h (τs s (σ j0)) (τs s' j0) *
        ∏ j, (if j = j0 then 1 else (if τs s (σ j) = τs s' j then (1 : ℝ) else 0)) := by
  simp only [Γ, amp, slater_eq_sum]
  have inner : ∀ k, ∑ b, h (τs s k) b * ∑ σ : Equiv.Perm (Fin N), (Equiv.Perm.sign σ : ℝ) *
      ∏ j, (fun (j : Fin N) (x : Fin M) => if x = τs s' j then (1 : ℝ) else 0) j
        (Function.update (τs s) k b (σ j)) =
      ∑ σ : Equiv.Perm (Fin N), (Equiv.Perm.sign σ : ℝ) * (h (τs s k) (τs s' (σ.symm k)) *
        ∏ j, (if j = σ.symm k then 1 else (if τs s (σ j) = τs s' j then (1 : ℝ) else 0))) := by
    intro k
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl; intro σ _
    simp_rw [prod_update_split (fun (j : Fin N) (x : Fin M) => if x = τs s' j then (1 : ℝ) else 0)]
    rw [Finset.sum_eq_single (τs s' (σ.symm k))]
    · simp; ring
    · intro b _ hb; simp [hb]
    · intro hh; exact absurd (Finset.mem_univ _) hh
  rw [Finset.sum_congr rfl (fun k _ => inner k), Finset.sum_comm]
  apply Finset.sum_congr rfl; intro σ _
  rw [← Finset.mul_sum, ← Equiv.sum_comp σ]
  congr 1
  apply Finset.sum_congr rfl; intro j0 _
  simp

theorem gamma_isSymm {h : Matrix (Fin M) (Fin M) ℝ} (hS : h.IsSymm) :
    (Γ h : Matrix (Conf M N) (Conf M N) ℝ).IsSymm := by
  ext s s'
  rw [Matrix.transpose_apply, gamma_leibniz, gamma_leibniz]
  rw [← Equiv.sum_comp (Equiv.inv (Equiv.Perm (Fin N)))]
  apply Finset.sum_congr rfl; intro σ _
  simp only [Equiv.inv_apply, Equiv.Perm.sign_inv]
  congr 1
  rw [← Equiv.sum_comp σ]
  apply Finset.sum_congr rfl; intro j0 _
  have e1 : σ⁻¹ (σ j0) = j0 := by simp
  rw [e1, hS.apply (τs s (σ j0)) (τs s' j0)]
  congr 1
  rw [← Equiv.prod_comp σ]
  apply Finset.prod_congr rfl; intro j _
  have e2 : σ⁻¹ (σ j) = j := by simp
  rw [e2]
  by_cases hj : j = j0
  · simp [hj]
  · have : σ j ≠ σ j0 := fun h' => hj (σ.injective h')
    simp [hj, this, eq_comm]

/-- Hopping amplitudes `t a b` on the edges of `G` (zero elsewhere). -/
def hopM (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] (t : Fin M → Fin M → ℝ) : Matrix (Fin M)
    (Fin M) ℝ :=
  fun a b => if G.Adj a b then t a b else 0

lemma hopM_const (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] (t : ℝ) :
    hopM G (fun _ _ => t) = t • G.adjMatrix ℝ := by
  ext a b; simp [hopM, SimpleGraph.adjMatrix_apply]

lemma hopM_isSymm (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] {t : Fin M → Fin M → ℝ}
    (ht : ∀ a b, t a b = t b a) : (hopM G t).IsSymm := by
  ext a b
  simp only [hopM, Matrix.transpose_apply]
  rw [ht b a]
  by_cases h : G.Adj a b
  · rw [ite_eq_left h.symm, ite_eq_left h]
  · rw [ite_eq_right (fun h' => h h'.symm), ite_eq_right h]

/-- The lattice-DFT Hamiltonian of spinless fermions with edge-dependent hopping `t a b`. -/
noncomputable def H0Fw (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] (t : Fin M → Fin M → ℝ)
    (Vint : Conf M N → ℝ) : Matrix (Conf M N) (Conf M N) ℝ :=
  Γ (-hopM G t) + Matrix.diagonal Vint

lemma H0Fw_isSymm (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] {t : Fin M → Fin M → ℝ}
    (ht : ∀ a b, t a b = t b a) (Vint : Conf M N → ℝ) : (H0Fw G t Vint).IsSymm := by
  unfold H0Fw
  refine Matrix.IsSymm.add (gamma_isSymm ?_) (Matrix.isSymm_diagonal Vint)
  exact (hopM_isSymm G ht).neg

/-- The lattice-DFT Hamiltonian of spinless fermions: hopping `t` on the edges of `G`,
configuration-diagonal interaction `Vint`, external potential coupled to the occupations. -/
noncomputable def H0F (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] (t : ℝ) (Vint : Conf M N → ℝ) :
    Matrix (Conf M N) (Conf M N) ℝ :=
  Γ (-t • G.adjMatrix ℝ) + Matrix.diagonal Vint

lemma H0F_eq_H0Fw (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] (t : ℝ) (Vint : Conf M N → ℝ) :
    H0F G t Vint = H0Fw G (fun _ _ => t) Vint := by
  unfold H0F H0Fw; rw [hopM_const, neg_smul]

lemma H0F_isSymm (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] (t : ℝ) (Vint : Conf M N → ℝ) :
    (H0F G t Vint).IsSymm := by
  unfold H0F
  refine Matrix.IsSymm.add (gamma_isSymm ?_) (Matrix.isSymm_diagonal Vint)
  exact (G.isSymm_adjMatrix).smul _

/-- With the potential included, the many-body Hamiltonian is the second quantisation of the
single-particle Hamiltonian `-t A + diag v`, plus the interaction. -/
theorem hamN_H0F (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] (t : ℝ) (Vint : Conf M N → ℝ)
    (v : Fin M → ℝ) :
    hamN (H0F G t Vint) occF v =
        Γ (-t • G.adjMatrix ℝ + Matrix.diagonal v) + Matrix.diagonal Vint := by
  unfold hamN H0F
  rw [gamma_add, gamma_diagonal]
  abel

theorem hamN_H0Fw (G : SimpleGraph (Fin M)) [DecidableRel G.Adj] (t : Fin M → Fin M → ℝ)
    (Vint : Conf M N → ℝ) (v : Fin M → ℝ) :
    hamN (H0Fw G t Vint) occF v = Γ (-hopM G t + Matrix.diagonal v) + Matrix.diagonal Vint := by
  unfold hamN H0Fw
  rw [gamma_add, gamma_diagonal]
  abel

end

end LatticeDFT
