/-- (H*) for `N = 2` at `{1, 2}`: `u = (0, 1, 3, 7)`, hop distances
`(2, 1, 2, 0, 1, 2)`, determinant of the table
`(34020*p^4*q*r^2*s + 119070*p^3*q^2*r^3 + 9720*p^3*r^3*s^2 + 34020*p^2*q*r^4*s)`. -/
theorem hstar_sqHop_2_3 {p q r s : ℝ} (hp : 0 < p) (hq : 0 < q) (hr : 0 < r) (hs : 0 < s)
    (Vint : Conf 4 2 → ℝ) :
    krylovPoly (H0Fw sqG (sqHop (-p) q r s) Vint) occF (e 3)
      (fun j => (Fintype.equivFin (Conf 4 2) j : ℕ)) ≠ 0 := by
  refine krylovPoly_ne_zero_of_table e (Ah := hopSq (sqHop (-p) q r s))
    (fun i j => gamma_cfg2 _ i j) occF ![0, 1, 3, 7] (fun i => sum_occF_cfg2 _ i) (dh := ![2, 1, 2, 0, 1, 2]) ?_
    (ic := 3) rfl
    (Tm := !![0, 0, (-p*q - r*s), (-8*p*q - 13*r*s), (-45*p*q - 125*r*s), (-220*p*q - 1085*r*s);
      0, p, 7*p, 37*p, 175*p, 781*p;
      0, 0, (-2*p*r), (-33*p*r), (-380*p*r), (-3795*p*r);
      1, 4, 16, 64, 256, 1024;
      0, (-r), (-12*r), (-112*r), (-960*r), (-7936*r);
      0, 0, (p*s + q*r), (17*p*s + 22*q*r), (207*p*s + 332*q*r), (2245*p*s + 4280*q*r)]) ?_ ?_ ?_ Vint
  · intro i j _ h
    fin_cases i <;> fin_cases j <;> first | decide | (exfalso; apply h; simp [hopSq, sqHop])
  · intro i k hk
    obtain rfl : k = 0 := Fin.ext hk
    fin_cases i <;> simp
  · intro i k k' hk
    fin_cases k <;> fin_cases k' <;> (try simp at hk) <;> fin_cases i <;>
      simp [Fin.sum_univ_succ, hopSq, sqHop] <;> ring
  · have hdet : Matrix.det (n := Fin 6) !![0, 0, (-p*q - r*s), (-8*p*q - 13*r*s), (-45*p*q - 125*r*s), (-220*p*q - 1085*r*s);
      0, p, 7*p, 37*p, 175*p, 781*p;
      0, 0, (-2*p*r), (-33*p*r), (-380*p*r), (-3795*p*r);
      1, 4, 16, 64, 256, 1024;
      0, (-r), (-12*r), (-112*r), (-960*r), (-7936*r);
      0, 0, (p*s + q*r), (17*p*s + 22*q*r), (207*p*s + 332*q*r), (2245*p*s + 4280*q*r)] =
        (34020*p^4*q*r^2*s + 119070*p^3*q^2*r^3 + 9720*p^3*r^3*s^2 + 34020*p^2*q*r^4*s) := by
      simp +decide [Matrix.det_succ_column_zero, Fin.sum_univ_succ, Fin.succAbove]
