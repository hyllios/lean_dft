/-- (H*) for 1 fermion on the square with one negative bond, at every
configuration. -/
theorem hstar_sqHop_one {p q r s : ℝ} (hp : 0 < p) (hq : 0 < q) (hr : 0 < r) (hs : 0 < s)
    (c : Conf 4 1) (Vint : Conf 4 1 → ℝ) :
    krylovPoly (H0Fw sqG (sqHop (-p) q r s) Vint) occF c
      (fun j => (Fintype.equivFin (Conf 4 1) j : ℕ)) ≠ 0 := by
  obtain ⟨i, rfl⟩ := e1.surjective c
  fin_cases i
  exacts [hstar_sqHop_1_0 hp hq hr hs Vint,
    hstar_sqHop_1_1 hp hq hr hs Vint,
    hstar_sqHop_1_2 hp hq hr hs Vint,
    hstar_sqHop_1_3 hp hq hr hs Vint]

/-! ### Two fermions (basis `cfg`, hopping table `hopSq`) -/

theorem gamma_cfg2 (t : Fin 4 → Fin 4 → ℝ) (i j : Fin 6) :
    (Γ (-hopM sqG t) : Matrix (Conf 4 2) (Conf 4 2) ℝ) (cfg i) (cfg j) = hopSq t i j := by
  have h := H0Fw_square t 0 i j
  simpa [H0Fw] using h

lemma sum_occF_cfg2 (u : Fin 4 → ℝ) (i : Fin 6) :
    ∑ x, u x * occF x (cfg i) =
      ![u 0 + u 1, u 0 + u 2, u 0 + u 3, u 1 + u 2, u 1 + u 3, u 2 + u 3] i := by
  fin_cases i <;> simp [occF, cfg, Fin.sum_univ_four]

/-! ### Certificates, 2 fermions -/

/-- (H*) for `N = 2` at `{0, 1}`: `u = (0, 1, 7, 3)`, hop distances
`(0, 1, 2, 2, 1, 2)`, determinant of the table
`-(30240*p^2*q^3*s^3 + 7560*p*q^4*r*s^2 + 7560*p*q^2*r*s^4 + 1890*q^3*r^2*s^3)`. -/
theorem hstar_sqHop_2_0 {p q r s : ℝ} (hp : 0 < p) (hq : 0 < q) (hr : 0 < r) (hs : 0 < s)
    (Vint : Conf 4 2 → ℝ) :
    krylovPoly (H0Fw sqG (sqHop (-p) q r s) Vint) occF (e 0)
      (fun j => (Fintype.equivFin (Conf 4 2) j : ℕ)) ≠ 0 := by
  refine krylovPoly_ne_zero_of_table e (Ah := hopSq (sqHop (-p) q r s))
    (fun i j => gamma_cfg2 _ i j) occF ![0, 1, 7, 3] (fun i => sum_occF_cfg2 _ i) (dh := ![0, 1, 2, 2, 1, 2]) ?_
    (ic := 0) rfl
    (Tm := !![1, 1, 1, 1, 1, 1;
      0, (-q), (-8*q), (-57*q), (-400*q), (-2801*q);
      0, 0, (p*s + q*r), (8*p*s + 11*q*r), (45*p*s + 90*q*r), (220*p*s + 670*q*r);
      0, 0, (-p*q - r*s), (-16*p*q - 13*r*s), (-185*p*q - 125*r*s), (-1880*p*q - 1085*r*s);
      0, s, 5*s, 21*s, 85*s, 341*s;
      0, 0, (-2*q*s), (-33*q*s), (-408*q*s), (-4565*q*s)]) ?_ ?_ ?_ Vint
  · intro i j _ h
    fin_cases i <;> fin_cases j <;> first | decide | (exfalso; apply h; simp [hopSq, sqHop])
  · intro i k hk
    obtain rfl : k = 0 := Fin.ext hk
    fin_cases i <;> simp
  · intro i k k' hk
    fin_cases k <;> fin_cases k' <;> (try simp at hk) <;> fin_cases i <;>
      simp [Fin.sum_univ_succ, hopSq, sqHop] <;> ring
  · have hdet : Matrix.det (n := Fin 6) !![1, 1, 1, 1, 1, 1;
      0, (-q), (-8*q), (-57*q), (-400*q), (-2801*q);
      0, 0, (p*s + q*r), (8*p*s + 11*q*r), (45*p*s + 90*q*r), (220*p*s + 670*q*r);
      0, 0, (-p*q - r*s), (-16*p*q - 13*r*s), (-185*p*q - 125*r*s), (-1880*p*q - 1085*r*s);
      0, s, 5*s, 21*s, 85*s, 341*s;
      0, 0, (-2*q*s), (-33*q*s), (-408*q*s), (-4565*q*s)] =
        -(30240*p^2*q^3*s^3 + 7560*p*q^4*r*s^2 + 7560*p*q^2*r*s^4 + 1890*q^3*r^2*s^3) := by
      simp +decide [Matrix.det_succ_column_zero, Fin.sum_univ_succ, Fin.succAbove]
      ring
    rw [hdet]
    exact neg_ne_zero.mpr (by positivity)

