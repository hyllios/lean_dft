import DFT.Lattice.Bridge.SquareHopping
import DFT.Lattice.StrongPotential.TopTable

/-!
# The square with one negative bond: exact leading-coefficient certificates

Generated by `scripts/gen_frustrated_square_lean.py`. `N` spinless fermions (`N = 1, 2, 3`) on
the 4-cycle `sqG` with symmetric hopping `sqHop (-p) q r s`
(`t₀₁ = −p`, `t₁₂ = q`, `t₂₃ = r`, `t₃₀ = s`, all of `p, q, r, s` positive). For every
configuration `c` the file gives a potential direction `u`, the hop distances `d` from `c`, the
table of top coefficients `T k (y)` (`T 0 = e_c`,
`T (k + 1) y = w y · T k y + Σ_{d z + 1 = d y} A y z · T k z`) and its determinant, a polynomial
in `p, q, r, s` with coefficients of one sign; `krylovPoly_ne_zero_of_table` turns this into (H*)
at `c` for every configuration-diagonal interaction.

* `sqHop`; bases `cfg1`, `cfg3` with `gamma_cfg1`, `gamma_cfg3` (the two-fermion basis `cfg`, `e`
  are in `Bridge.Square`, its hopping table `hopSq` in `Bridge.SquareHopping`); `gamma_cfg2`,
  `sum_occF_cfg1/2/3`;
* `hstar_sqHop_N_i`: (H*) at the configuration `i` of the basis, for `N` fermions;
* `hstar_sqHop_one`, `hstar_sqHop_two`, `hstar_sqHop_three`: (H*) at every configuration.
-/

set_option linter.style.longLine false
set_option linter.unusedSimpArgs false

namespace DFT

open Matrix

namespace Bridge.Square

/-- Symmetric hopping on the square with `t₀₁ = a`, `t₁₂ = b`, `t₂₃ = c`, `t₃₀ = d` (zero on the
diagonals `0 2`, `1 3` and on the sites). -/
def sqHop (a b c d : ℝ) : Fin 4 → Fin 4 → ℝ :=
  fun x y => (!![0, a, 0, d; a, 0, b, 0; 0, b, 0, c; d, 0, c, 0] : Matrix (Fin 4) (Fin 4) ℝ) x y

/-! ### One fermion -/

/-- The configurations of 1 fermion on the square, in the order `0, 1, 2, 3`. -/
def cfg1 : Fin 4 → Conf 4 1 :=
  ![⟨{0}, by decide⟩, ⟨{1}, by decide⟩, ⟨{2}, by decide⟩, ⟨{3}, by decide⟩]

lemma cfg1_bijective : Function.Bijective cfg1 := by decide

/-- The basis `cfg1` as an equivalence. -/
noncomputable def e1 : Fin 4 ≃ Conf 4 1 := Equiv.ofBijective cfg1 cfg1_bijective

/-- The occupied sites of `cfg1 i`, in increasing order. -/
def pos1 : Fin 4 → Fin 1 → Fin 4 :=
  ![![0], ![1], ![2], ![3]]

lemma pos1_strictMono (i : Fin 4) : StrictMono (pos1 i) := by
  fin_cases i <;> (rw [Fin.strictMono_iff_lt_succ]; decide)

lemma τs_cfg1 (i : Fin 4) : τs (cfg1 i) = pos1 i := by
  unfold τs
  have h := Finset.orderEmbOfFin_unique (cfg1 i).2 (f := pos1 i)
    (by fin_cases i <;> decide) (pos1_strictMono i)
  exact (congrArg (fun f : Fin 1 → Fin 4 => f) h).symm ▸ rfl

/-- The hopping part of `H0Fw sqG t 0` for 1 fermion in the basis `cfg1`. -/
def hop1 (t : Fin 4 → Fin 4 → ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![0, -t 0 1, 0, -t 0 3;
     -t 1 0, 0, -t 1 2, 0;
     0, -t 2 1, 0, -t 2 3;
     -t 3 0, 0, -t 3 2, 0]

theorem gamma_cfg1 (t : Fin 4 → Fin 4 → ℝ) (i j : Fin 4) :
    (Γ (-hopM sqG t) : Matrix (Conf 4 1) (Conf 4 1) ℝ) (cfg1 i) (cfg1 j) = hop1 t i j := by
  simp only [Γ, amp, slater, τs_cfg1]
  fin_cases i <;> fin_cases j <;>
    simp +decide [Fin.sum_univ_succ, Matrix.det_fin_one, Function.update, hopM, sqG, pos1, hop1]

lemma sum_occF_cfg1 (u : Fin 4 → ℝ) (i : Fin 4) :
    ∑ x, u x * occF x (cfg1 i) = ![u 0, u 1, u 2, u 3] i := by
  fin_cases i <;> simp [occF, cfg1, Fin.sum_univ_four]

/-! ### Certificates, 1 fermion -/

/-- (H*) for `N = 1` at `{0}`: `u = (0, 1, 3, 7)`, hop distances
`(0, 1, 2, 1)`, determinant of the table
`(24*p^2*q*s + 12*p*r*s^2)`. -/
theorem hstar_sqHop_1_0 {p q r s : ℝ} (hp : 0 < p) (hq : 0 < q) (hr : 0 < r) (hs : 0 < s)
    (Vint : Conf 4 1 → ℝ) :
    krylovPoly (H0Fw sqG (sqHop (-p) q r s) Vint) occF (e1 0)
      (fun j => (Fintype.equivFin (Conf 4 1) j : ℕ)) ≠ 0 := by
  refine krylovPoly_ne_zero_of_table e1 (Ah := hop1 (sqHop (-p) q r s))
    (fun i j => gamma_cfg1 _ i j) occF ![0, 1, 3, 7] (fun i => sum_occF_cfg1 _ i) (dh := ![0, 1, 2, 1]) ?_
    (ic := 0) rfl
    (Tm := !![1, 0, 0, 0;
      0, p, p, p;
      0, 0, (-p*q + r*s), (-4*p*q + 10*r*s);
      0, (-s), (-7*s), (-49*s)]) ?_ ?_ ?_ Vint
  · intro i j _ h
    fin_cases i <;> fin_cases j <;> first | decide | (exfalso; apply h; simp [hop1, sqHop])
  · intro i k hk
    obtain rfl : k = 0 := Fin.ext hk
    fin_cases i <;> simp
  · intro i k k' hk
    fin_cases k <;> fin_cases k' <;> (try simp at hk) <;> fin_cases i <;>
      simp [Fin.sum_univ_succ, hop1, sqHop] <;> ring
  · have hdet : Matrix.det (n := Fin 4) !![1, 0, 0, 0;
      0, p, p, p;
      0, 0, (-p*q + r*s), (-4*p*q + 10*r*s);
      0, (-s), (-7*s), (-49*s)] =
        (24*p^2*q*s + 12*p*r*s^2) := by
      simp +decide [Matrix.det_succ_column_zero, Fin.sum_univ_succ, Fin.succAbove]
      ring
    rw [hdet]
    positivity

/-- (H*) for `N = 1` at `{1}`: `u = (0, 1, 7, 3)`, hop distances
`(1, 0, 1, 2)`, determinant of the table
`(28*p^2*q*s + 21*p*q^2*r)`. -/
theorem hstar_sqHop_1_1 {p q r s : ℝ} (hp : 0 < p) (hq : 0 < q) (hr : 0 < r) (hs : 0 < s)
    (Vint : Conf 4 1 → ℝ) :
    krylovPoly (H0Fw sqG (sqHop (-p) q r s) Vint) occF (e1 1)
      (fun j => (Fintype.equivFin (Conf 4 1) j : ℕ)) ≠ 0 := by
  refine krylovPoly_ne_zero_of_table e1 (Ah := hop1 (sqHop (-p) q r s))
    (fun i j => gamma_cfg1 _ i j) occF ![0, 1, 7, 3] (fun i => sum_occF_cfg1 _ i) (dh := ![1, 0, 1, 2]) ?_
    (ic := 1) rfl
    (Tm := !![0, p, p, p;
      1, 1, 1, 1;
      0, (-q), (-8*q), (-57*q);
      0, 0, (-p*s + q*r), (-4*p*s + 11*q*r)]) ?_ ?_ ?_ Vint
  · intro i j _ h
    fin_cases i <;> fin_cases j <;> first | decide | (exfalso; apply h; simp [hop1, sqHop])
  · intro i k hk
    obtain rfl : k = 0 := Fin.ext hk
    fin_cases i <;> simp
  · intro i k k' hk
    fin_cases k <;> fin_cases k' <;> (try simp at hk) <;> fin_cases i <;>
      simp [Fin.sum_univ_succ, hop1, sqHop] <;> ring
  · have hdet : Matrix.det (n := Fin 4) !![0, p, p, p;
      1, 1, 1, 1;
      0, (-q), (-8*q), (-57*q);
      0, 0, (-p*s + q*r), (-4*p*s + 11*q*r)] =
        (28*p^2*q*s + 21*p*q^2*r) := by
      simp +decide [Matrix.det_succ_column_zero, Fin.sum_univ_succ, Fin.succAbove]
      ring
    rw [hdet]
    positivity

