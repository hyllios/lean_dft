  fin_cases i
  exacts [hstar_sqHop_2_0 hp hq hr hs Vint,
    hstar_sqHop_2_1 hp hq hr hs Vint,
    hstar_sqHop_2_2 hp hq hr hs Vint,
    hstar_sqHop_2_3 hp hq hr hs Vint,
    hstar_sqHop_2_4 hp hq hr hs Vint,
    hstar_sqHop_2_5 hp hq hr hs Vint]

/-! ### Three fermions -/

/-- The configurations of 3 fermions on the square, in the order `012, 013, 023, 123`. -/
def cfg3 : Fin 4 → Conf 4 3 :=
  ![⟨{0, 1, 2}, by decide⟩, ⟨{0, 1, 3}, by decide⟩, ⟨{0, 2, 3}, by decide⟩, ⟨{1, 2, 3}, by decide⟩]

lemma cfg3_bijective : Function.Bijective cfg3 := by decide

/-- The basis `cfg3` as an equivalence. -/
noncomputable def e3 : Fin 4 ≃ Conf 4 3 := Equiv.ofBijective cfg3 cfg3_bijective

/-- The occupied sites of `cfg3 i`, in increasing order. -/
def pos3 : Fin 4 → Fin 3 → Fin 4 :=
  ![![0, 1, 2], ![0, 1, 3], ![0, 2, 3], ![1, 2, 3]]

lemma pos3_strictMono (i : Fin 4) : StrictMono (pos3 i) := by
  fin_cases i <;> (rw [Fin.strictMono_iff_lt_succ]; decide)

lemma τs_cfg3 (i : Fin 4) : τs (cfg3 i) = pos3 i := by
  unfold τs
  have h := Finset.orderEmbOfFin_unique (cfg3 i).2 (f := pos3 i)
    (by fin_cases i <;> decide) (pos3_strictMono i)
  exact (congrArg (fun f : Fin 3 → Fin 4 => f) h).symm ▸ rfl

/-- The hopping part of `H0Fw sqG t 0` for 3 fermions in the basis `cfg3`. -/
def hop3 (t : Fin 4 → Fin 4 → ℝ) : Matrix (Fin 4) (Fin 4) ℝ :=
  !![0, -t 2 3, 0, -t 0 3;
     -t 3 2, 0, -t 1 2, 0;
     0, -t 2 1, 0, -t 0 1;
     -t 3 0, 0, -t 1 0, 0]

theorem gamma_cfg3 (t : Fin 4 → Fin 4 → ℝ) (i j : Fin 4) :
    (Γ (-hopM sqG t) : Matrix (Conf 4 3) (Conf 4 3) ℝ) (cfg3 i) (cfg3 j) = hop3 t i j := by
  simp only [Γ, amp, slater, τs_cfg3]
  fin_cases i <;> fin_cases j <;>
    simp +decide [Fin.sum_univ_succ, Matrix.det_fin_three, Function.update, hopM, sqG, pos3, hop3]

lemma sum_occF_cfg3 (u : Fin 4 → ℝ) (i : Fin 4) :
    ∑ x, u x * occF x (cfg3 i) = ![u 0 + u 1 + u 2, u 0 + u 1 + u 3, u 0 + u 2 + u 3, u 1 + u 2 + u 3] i := by
  fin_cases i <;> simp [occF, cfg3, Fin.sum_univ_four]

