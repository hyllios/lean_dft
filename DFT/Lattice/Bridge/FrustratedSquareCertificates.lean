/-- (H*) for 2 fermions on the square with one negative bond, at every
configuration. -/
theorem hstar_sqHop_two {p q r s : ℝ} (hp : 0 < p) (hq : 0 < q) (hr : 0 < r) (hs : 0 < s)
    (c : Conf 4 2) (Vint : Conf 4 2 → ℝ) :
