  rw [Matrix.mul_apply]
  simp only [Matrix.transpose_apply, symKry, hpSD]
  fin_cases c <;> simp [PSD] at hc <;> fin_cases a <;> fin_cases k <;>
    simp [BSD, KSD, KSD0, KSD1, KSD2, KSD3, HPSD0, HPSD1, HPSD2, PSD, Fin.sum_univ_succ] <;> norm_num

